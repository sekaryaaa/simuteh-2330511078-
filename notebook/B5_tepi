oses.py', 'praproses_acuan.py', 'utils_tepi.py', 'SIMUTEH_utils_tepi.ipynb', 'bercak.py']\n"]}]},{"cell_type":"code","source":["\n","# Kode 1.1 Persiapan: modul, data, praproses, dan tepi acuan\n","\n","import os\n","import sys\n","import json\n","\n","# Menentukan direktori utama proyek\n","BASE_DIR = \"/content/drive/MyDrive/SIMUTEH/simuteh-2330511078\"\n","SRC_DIR = os.path.join(BASE_DIR, \"src\")\n","\n","# Menambahkan direktori src agar modul dapat diimpor\n","sys.path.insert(0, SRC_DIR)\n","\n","import cv2, numpy as np, pandas as pd, matplotlib.pyplot as plt\n","\n","from utils_cv import baca, tampil\n","from praproses import praproses\n","from utils_tepi import tepi_acuan, skor_tepi, iou, mask_daun_awal, bercak_awal\n","\n","pd.set_option(\"display.width\", 160)\n","pd.set_option(\"display.max_columns\", 20)\n","\n","# Memuat parameter hasil Evaluasi P1-P4\n","from praproses import PARAM_BAWAAN\n","\n","PARAM = PARAM_BAWAAN.copy()\n","\n","# Memuat label dataset\n","label = pd.read_csv(os.path.join(BASE_DIR, \"data\", \"sintetis\", \"label.csv\"))\n","\n","# Fungsi untuk memuat citra dan mask acuan\n","def muat(nama):\n","    img = baca(os.path.join(BASE_DIR, \"data\", \"sintetis\", \"citra\", nama))\n","    md = cv2.imread(os.path.join(BASE_DIR, \"data\", \"sintetis\", \"mask_daun\", nama), 0)\n","    mb = cv2.imread(os.path.join(BASE_DIR, \"data\", \"sintetis\", \"mask_bercak\", nama), 0)\n","    return img, md, mb\n","\n","# Memuat citra teh_041.png\n","img, md, mb = muat(\"teh_041.png\")\n","\n","# Melakukan praproses citra\n","pra = praproses(img, PARAM)\n","\n","# Menggabungkan tepi acuan daun dan bercak\n","acuan = cv2.bitwise_or(tepi_acuan(md), tepi_acuan(mb))\n","\n","# Menampilkan hasil\n","tampil(\n","    [img, pra, acuan],\n","    [\"Citra mentah\", \"Sesudah praproses\", \"Tepi acuan (daun + bercak)\"]\n",")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":180},"id":"W4JCRZ-Ew51H","executionInfo":{"status":"ok","timestamp":1794897173077,"user_tz":-420,"elapsed":3791,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"99edd1d1-b504-4961-eb82-053169e3d28d"},"execution_count":5,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x400 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["\n","# Kode 1.2 Gradien Sobel manual: Gx, Gy, magnitudo, dan arah\n","\n","g = pra[:, :, 2].astype(np.float32)  # kanal R hasil praproses\n","\n","kx = np.array([\n","    [-1, 0, 1],\n","    [-2, 0, 2],\n","    [-1, 0, 1]\n","], np.float32)\n","\n","ky = kx.T\n","\n","gx = cv2.filter2D(g, cv2.CV_32F, kx)  # turunan arah x (tepi vertikal)\n","gy = cv2.filter2D(g, cv2.CV_32F, ky)  # turunan arah y (tepi horizontal)\n","\n","mag = np.sqrt(gx ** 2 + gy ** 2)\n","arah = np.degrees(np.arctan2(gy, gx))\n","\n","# Bandingkan dengan fungsi pustaka\n","gx_cv = cv2.Sobel(g, cv2.CV_32F, 1, 0, ksize=3)\n","\n","print(\"selisih maks gx manual vs cv2.Sobel:\", np.abs(gx - gx_cv).max())\n","print(\"magnitudo maks:\", mag.max().round(1))\n","\n","# Visualisasi hasil\n","plt.figure(figsize=(16, 3.6))\n","\n","for i, (c, jd) in enumerate([\n","    (gx, \"Gx\"),\n","    (gy, \"Gy\"),\n","    (mag, \"Magnitudo\"),\n","    (arah, \"Arah (derajat)\")\n","]):\n","    plt.subplot(1, 4, i + 1)\n","    plt.imshow(c, cmap=\"twilight\" if i == 3 else \"gray\")\n","    plt.title(jd)\n","    plt.axis(\"off\")\n","    plt.colorbar(fraction=0.035)\n","\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":161},"id":"nc8G6CRCxJyz","executionInfo":{"status":"ok","timestamp":1794897176429,"user_tz":-420,"elapsed":1021,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"6c7aff53-ad02-49e3-c014-201e972b6015"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["selisih maks gx manual vs cv2.Sobel: 0.0\n","magnitudo maks: 595.7\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x360 with 8 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# **Langkah 1.3 Empat operator pada satu citra**"],"metadata":{"id":"jW3RO7pMxxdT"}},{"cell_type":"code","source":["\n","# Kode 1.3 Fungsi Sobel, Prewitt, LoG, dan Canny serta perbandingannya\n","\n","def tepi_sobel(g, T=100):\n","    g = g.astype(np.float32)\n","    m = np.hypot(\n","        cv2.Sobel(g, cv2.CV_32F, 1, 0),\n","        cv2.Sobel(g, cv2.CV_32F, 0, 1))\n","    return ((m > T) * 255).astype(np.uint8)\n","\n","\n","def tepi_prewitt(g, T=75):\n","    kx = np.array([\n","        [-1, 0, 1],\n","        [-1, 0, 1],\n","        [-1, 0, 1]\n","    ], np.float32)\n","\n","    g = g.astype(np.float32)\n","\n","    m = np.hypot(\n","        cv2.filter2D(g, -1, kx),\n","        cv2.filter2D(g, -1, kx.T) )\n","\n","    return ((m > T) * 255).astype(np.uint8)\n","\n","\n","def tepi_log(g, sigma=3.0, frac=0.2):\n","    \"\"\"Laplacian of Gaussian: tepi = perlintasan nol yang cukup kuat.\"\"\"\n","\n","    L = cv2.Laplacian(\n","        cv2.GaussianBlur(g.astype(np.float32), (0, 0), sigma),\n","        cv2.CV_32F )\n","\n","    mn = cv2.erode(L, np.ones((3, 3)))\n","    mx = cv2.dilate(L, np.ones((3, 3)))\n","\n","    return (\n","        ((mn < 0) & (mx > 0) & (mx - mn > frac * np.abs(L).max())) * 255\n","    ).astype(np.uint8)\n","\n","\n","def tepi_canny(g, lo=30, hi=90, sigma=2.0):\n","    if sigma > 0:\n","        g = cv2.GaussianBlur(g, (0, 0), sigma)\n","\n","    return cv2.Canny(g, lo, hi)\n","\n","# Menggabungkan fungsi operator tepi\n","metode = {\n","    \"Sobel\": tepi_sobel,\n","    \"Prewitt\": tepi_prewitt,\n","    \"LoG\": tepi_log,\n","    \"Canny\": tepi_canny}\n","\n","# Mengambil kanal R hasil praproses\n","g = pra[:, :, 2]\n","\n","# Menjalankan keempat operator\n","hasil = {nm: f(g) for nm, f in metode.items()}\n","\n","# Menampilkan hasil perbandingan\n","tampil(\n","    list(hasil.values()),\n","    [f\"{nm} P/R/F1={skor_tepi(e, acuan)}\" for nm, e in hasil.items()],\n","    ukuran=(17, 3.6)\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":141},"id":"oQiTNO2fx9jI","executionInfo":{"status":"ok","timestamp":1794897180434,"user_tz":-420,"elapsed":896,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"d93fa010-5d1c-45e3-fd13-ca14dc953145"},"execution_count":7,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1700x360 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# **Kode 1.4 Perbandingan menyeluruh**"],"metadata":{"id":"-1cewUCkzCI_"}},{"cell_type":"code","source":["\n","# Kode 1.4 Tabel presisi, recall, dan F1 tepi\n","\n","baris = []\n","\n","for _, d in label[label.kelas != \"sehat\"].iterrows():\n","    img, md, mb = muat(d.nama_file)\n","\n","    ac = cv2.bitwise_or(\n","        tepi_acuan(md),\n","        tepi_acuan(mb)  )\n","\n","    for sumber, im in [\n","        (\"mentah\", img),\n","        (\"praproses\", praproses(img, PARAM)) ]:\n","\n","        for kanal, g in [\n","            (\"Gray\", cv2.cvtColor(im, cv2.COLOR_BGR2GRAY)),\n","            (\"R\", im[:, :, 2]) ]:\n","\n","            for nm, f in metode.items():\n","\n","                p, r, f1 = skor_tepi(f(g), ac)\n","\n","                baris.append([\n","                    d.kondisi_cahaya,\n","                    sumber, kanal,\n","                    nm, p,\n","                    r, f1 ])\n","\n","# Membuat DataFrame hasil pengujian\n","tabel_tepi = pd.DataFrame(\n","    baris,\n","    columns=[\"kondisi\", \"sumber\", \"kanal\", \"metode\", \"P\", \"R\", \"F1\"] )\n","\n","# Menghitung rata-rata P, R, dan F1\n","ringkas = (\n","    tabel_tepi\n","    .groupby([\"sumber\", \"kanal\", \"metode\"])[[\"P\", \"R\", \"F1\"]]\n","    .mean()\n","    .round(3) )\n","\n","print(ringkas)\n","\n","# Menyimpan tabel hasil ke folder hasil\n","tabel_tepi.to_csv(\n","    os.path.join(BASE_DIR, \"hasil\", \"p5_tabel_tepi.csv\"),\n","    index=False )\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6dvWGGQYzw9w","executionInfo":{"status":"ok","timestamp":1794897237725,"user_tz":-420,"elapsed":53497,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"f0efeaba-9e6c-493c-819f-3186845fec42"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["                             P      R     F1\n","sumber    kanal metode                      \n","mentah    Gray  Canny    0.760  0.749  0.753\n","                LoG      0.640  0.998  0.777\n","                Prewitt  0.799  0.966  0.866\n","                Sobel    0.760  0.973  0.842\n","          R     Canny    0.988  0.978  0.982\n","                LoG      0.912  0.999  0.951\n","                Prewitt  0.542  0.997  0.645\n","                Sobel    0.486  0.997  0.589\n","praproses Gray  Canny    0.671  0.951  0.780\n","                LoG      0.554  0.998  0.708\n","                Prewitt  0.548  0.998  0.694\n","                Sobel    0.515  0.999  0.663\n","          R     Canny    0.948  0.992  0.967\n","                LoG      0.832  0.999  0.901\n","                Prewitt  0.435  0.999  0.567\n","                Sobel    0.391  0.999  0.522\n"]}]},{"cell_type":"markdown","source":["#**Kode 1.5 Grafik F! per kondisi cahaya**"],"metadata":{"id":"sal5DG6h3AgW"}},{"cell_type":"code","source":["\n","# Kode 1.5 Grafik F1 per kondisi cahaya\n","\n","# Memilih data kanal R sesudah praproses\n","df_grafik = tabel_tepi[\n","    (tabel_tepi[\"sumber\"] == \"praproses\") &\n","    (tabel_tepi[\"kanal\"] == \"R\")]\n","\n","# Menghitung rata-rata F1 berdasarkan kondisi cahaya dan operator\n","pivot_f1 = df_grafik.pivot_table(\n","    index=\"kondisi\",\n","    columns=\"metode\",\n","    values=\"F1\",\n","    aggfunc=\"mean\")\n","\n","# Membuat grafik batang\n","ax = pivot_f1.plot(\n","    kind=\"bar\",\n","    figsize=(10, 5),\n","    width=0.8)\n","\n","plt.title(\"Perbandingan F1 Tepi per Kondisi Cahaya\")\n","plt.xlabel(\"Kondisi Cahaya\")\n","plt.ylabel(\"Nilai F1\")\n","plt.ylim(0, 1)\n","plt.xticks(rotation=0)\n","plt.legend(title=\"Operator\")\n","plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.5)\n","plt.tight_layout()\n","\n","# Menyimpan grafik\n","plt.savefig(\n","    os.path.join(BASE_DIR, \"hasil\", \"p5_f1_kondisi.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\")\n","\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":315},"id":"oyoike482971","executionInfo":{"status":"ok","timestamp":1794897275754,"user_tz":-420,"elapsed":1421,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"2d8a8854-9f89-43dd-e6a6-00f6b22a10d1"},"execution_count":9,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# **Langkah 2.2 Pengaruh sigma dan ambang**\n","\n","**Kode 2.1 Eksperimen sigma dan ambang Canny**"],"metadata":{"id":"60BAXq_BRVU6"}},{"cell_type":"code","source":["baris = []\n","\n","for _, d in label[label.kelas != \"sehat\"].iterrows():\n","    img, md, mb = muat(d.nama_file)\n","\n","    g = praproses(img, PARAM)[:, :, 2]\n","\n","    ad, ab = tepi_acuan(md), tepi_acuan(mb)\n","    ac = cv2.bitwise_or(ad, ab)\n","\n","    for sigma in [0, 1.0, 2.0]:\n","        for lo, hi in [(30, 90), (50, 150), (100, 200)]:\n","\n","            e = tepi_canny(g, lo, hi, sigma)\n","            p, r, f1 = skor_tepi(e, ac)\n","            r_bercak = skor_tepi(e, ab)[1]\n","\n","            baris.append([\n","                d.kelas, sigma,\n","                f\"{lo}/{hi}\",\n","                p, r, f1, r_bercak ])\n","\n","canny = pd.DataFrame(\n","    baris,\n","    columns=[\n","        \"kelas\", \"sigma\", \"ambang\", \"P\", \"R\", \"F1\", \"R_bercak\" ])\n","\n","print(\n","    canny.groupby([\"sigma\", \"ambang\"])[\n","        [\"P\", \"R\", \"F1\", \"R_bercak\"] ].mean().round(3))\n","\n","print(\n","    canny.pivot_table(\n","        index=[\"sigma\", \"ambang\"],\n","        columns=\"kelas\",\n","        values=\"R_bercak\"\n","    ).round(3))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5h4MiBCORuX1","executionInfo":{"status":"ok","timestamp":1794897291030,"user_tz":-420,"elapsed":7564,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"dac7810e-ec13-491e-a3f1-4a666fc18357"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["                   P      R     F1  R_bercak\n","sigma ambang                                \n","0.0   100/200  0.484  0.996  0.589     0.988\n","      30/90    0.019  0.998  0.038     0.994\n","      50/150   0.110  0.997  0.167     0.990\n","1.0   100/200  0.978  0.996  0.987     0.987\n","      30/90    0.207  0.997  0.298     0.989\n","      50/150   0.820  0.996  0.880     0.988\n","2.0   100/200  0.818  0.812  0.815     0.753\n","      30/90    0.948  0.992  0.967     0.964\n","      50/150   0.987  0.980  0.983     0.923\n","kelas          berat  ringan\n","sigma ambang                \n","0.0   100/200  0.986   0.991\n","      30/90    0.994   0.994\n","      50/150   0.988   0.992\n","1.0   100/200  0.984   0.991\n","      30/90    0.985   0.992\n","      50/150   0.985   0.991\n","2.0   100/200  0.758   0.747\n","      30/90    0.965   0.963\n","      50/150   0.904   0.942\n"]}]},{"cell_type":"markdown","source":["#**Langkah 2.3 Ambang Otomatis**\n","\n","**Kode 2.2 Ambang Canny otomatis berbasis median**"],"metadata":{"id":"4i3cbSnfUET1"}},{"cell_type":"code","source":["def canny_otomatis(g, s=0.33):\n","    \"\"\"\n","    Ambang dari median intensitas:\n","    bawah = (1-s) x median\n","    atas = (1+s) x median.\n","    \"\"\"\n","    v = np.median(g)\n","\n","    return cv2.Canny(\n","        g,\n","        int(max(0, (1 - s) * v)),\n","        int(min(255, (1 + s) * v)))\n","\n","baris = []\n","\n","for _, d in label[label.kelas != \"sehat\"].iterrows():\n","    img, md, mb = muat(d.nama_file)\n","\n","    ac = cv2.bitwise_or(\n","        tepi_acuan(md),\n","        tepi_acuan(mb))\n","\n","    pra_ = praproses(img, PARAM)\n","\n","    for kanal, g in [\n","        (\"Gray\", cv2.cvtColor(pra_, cv2.COLOR_BGR2GRAY)),\n","        (\"R\", pra_[:, :, 2])]:\n","\n","        baris.append([\n","            d.kondisi_cahaya,\n","            kanal, \"otomatis\",\n","            skor_tepi(canny_otomatis(g), ac)[2],\n","            np.median(g)])\n","\n","        baris.append([\n","            d.kondisi_cahaya,\n","            kanal, \"tetap 30/90\",\n","            skor_tepi(tepi_canny(g), ac)[2],\n","            np.median(g)])\n","\n","auto = pd.DataFrame(\n","    baris,\n","    columns=[\"kondisi\", \"kanal\", \"ambang\", \"F1\", \"median\"])\n","\n","print(\n","    auto.pivot_table(\n","        index=[\"kanal\", \"ambang\"],\n","        columns=\"kondisi\",\n","        values=\"F1\" ).round(3))\n","\n","print(\n","    auto.groupby([\"kanal\", \"kondisi\"])[\"median\"]\n","    .mean().round(1))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"j1mP6hr3UVFW","executionInfo":{"status":"ok","timestamp":1794897304447,"user_tz":-420,"elapsed":3719,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}},"outputId":"b8348263-d448-45a2-ef09-e6f70213b628"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["kondisi            bayangan  gelap  kontras_rendah  normal  terang\n","kanal ambang                                                      \n","Gray  otomatis        0.531  0.475           0.814   0.724   0.848\n","      tetap 30/90     0.739  0.738           0.922   0.746   0.755\n","R     otomatis        0.372  0.341           0.785   0.810   0.908\n","      tetap 30/90     0.967  0.981           0.982   0.987   0.919\n","kanal  kondisi       \n","Gray   bayangan          119.5\n","       gelap             132.5\n","       kontras_rendah    149.6\n","       normal            169.5\n","       terang            196.4\n","R      bayangan          125.6\n","       gelap             154.0\n","       kontras_rendah    151.6\n","       normal            175.8\n","       terang            202.1\n","Name: median, dtype: float64\n"]}]},{"cell_type":"markdown","source":["#**Langkah 2.4 Kegiatan Sendiri**"],"metadata":{"id":"rhZD7BVuWhzz"}},{"cell_type":"markdown","source":["\n","1.   Menghaluskan Citra dengan Gaussian\n","2.   Menghiitung magnitudi Sobel\n","3.   Menhitung ambang berdasarkan persentil\n","4.   Deteksi tepi Canny\n","\n"],"metadata":{"id":"fBZy9G7qW_mh"}},{"cell_type":"code","source":["def canny_persentil(g, q, rasio=0.4, sigma=2.0):\n","\n","    # 1. Menghaluskan citra dengan Gaussian\n","    halus = cv2.GaussianBlur(\n","        g.astype(np.float32),\n","        (0, 0),\n","        sigma )\n","\n","    # 2. Menghitung magnitudo Sobel\n","    gx = cv2.Sobel(halus, cv2.CV_32F, 1, 0, ksize=3)\n","    gy = cv2.Sobel(halus, cv2.CV_32F, 0, 1, ksize=3)\n","    mag = np.sqrt(gx**2 + gy**2)\n","\n","    # 3. Menghitung ambang berdasarkan persentil\n","    atas = np.percentile(mag, q)\n","    bawah = rasio * atas\n","\n","    # 4. Deteksi tepi Canny\n","    tepi = cv2.Canny(\n","        halus.astype(np.uint8),\n","        int(bawah),\n","        int(atas))\n","\n","    return tepi"],"metadata":{"id":"lScgqB_dXEwM","executionInfo":{"status":"ok","timestamp":1794897314216,"user_tz":-420,"elapsed":17,"user":{"displayName":"Alya Sekar","userId":"04718222048603349765"}}},"execution_count":12,"outputs":[]},{"cell_type":"markdown","source":["**Menguji Persentil**"],"metadata":{"id":"gKn7hVnwYOFj"}},{"cell_type":"code","source":["baris = []\n","\n","for _, d in label[label.kelas != \"sehat\"].iterrows():\n","\n","    img, md, mb = muat(d.nama_file)\n","    pra_ = praproses(img, PARAM)\n","    ac = cv2.bitwise_or(\n","        tepi_acuan(md),\n","      